# URL del backend. En desarrollo local, el backend corre en el puerto 3000
# (el que ves en el mensaje "🚀 Servidor SB Metalúrgica corriendo en...").
VITE_API_URL=http://localhost:3000/api

# Datos que aparecen en el membrete de los documentos generados (opcional).
# Si no se definen, se usan valores de ejemplo genéricos.
VITE_EMPRESA_NOMBRE=SB Metalúrgica SA
VITE_EMPRESA_DIRECCION=Av. Médicos del Chaco esquina Guarambaré
VITE_EMPRESA_EMAIL=contacto@ejemplo.com
VITE_EMPRESA_TELEFONO=(021) 000-000
