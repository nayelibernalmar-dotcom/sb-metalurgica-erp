# Copiá este archivo como ".env" y completá los valores reales.
# NUNCA subas el archivo ".env" a GitHub.

# Conexión a PostgreSQL
# Local: reemplazá USUARIO y CONTRASENA con tus propios datos de PostgreSQL.
# Render: se genera automáticamente al crear la base de datos
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/sb_metalurgica
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Generá el secreto con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERAR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Usuario administrador inicial. No reutilices credenciales reales en este archivo.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA
